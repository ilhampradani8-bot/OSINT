        });
        playSound('click');
      });

      ['realtime-name', 'realtime-location', 'realtime-address', 'realtime-phone', 'realtime-email'].forEach(id => {
        document.getElementById(id)?.addEventListener('keyup', (e) => {
          if (e.key === 'Enter') document.getElementById('btn-start-stream').click();
        });
      });

      document.getElementById('btn-clear-canvas')?.addEventListener('click', () => {
        graph.clear();
        playSound('click');
      });

      document.getElementById('menu-reset-graph')?.addEventListener('click', () => {
        graph.clear();
        playSound('click');
      });

      // Log Page Controls
      document.getElementById('btn-refresh-logs')?.addEventListener('click', () => {
        playSound('click');
        const lvl = document.getElementById('log-level-filter')?.value || 'ALL';
        loadSecurityLogs(lvl);
      });

      document.getElementById('log-level-filter')?.addEventListener('change', (e) => {
        playSound('click');
        loadSecurityLogs(e.target.value);
      });

      document.getElementById('btn-clear-sql-logs')?.addEventListener('click', clearSecurityLogs);
      document.getElementById('btn-export-logs')?.addEventListener('click', exportSecurityLogs);

      // Close Sheet Listeners
      document.getElementById('btn-close-sheet')?.addEventListener('click', () => {
        playSound('click');
        const sheet = document.getElementById('inapp-sheet-container');
        if (sheet) sheet.style.display = 'none';
      });

      // Menubar Ekspor
      document.getElementById('menu-ekspor')?.addEventListener('click', () => {
        const report = {
          tool: 'MY-OSINT 95 Real-Time Maltego Edition',
          exported_at: new Date().toISOString(),
          nodes_mapped: graph.nodes,
          edges_mapped: graph.edges,
          dossier: masterDossier
        };
        const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `MALTEGO_GRAPH_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        playSound('success');
      });

      // Load initial logs in background
      loadSecurityLogs();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
  </script>
</body>
</html>

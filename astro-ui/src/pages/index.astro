      if (winIcon) winIcon.innerText = meta.icon;
      if (taskTitle) taskTitle.innerText = meta.title;
      if (taskIcon) taskIcon.innerText = meta.icon;

      const startMenu = document.getElementById('start-menu');
      if (startMenu) startMenu.classList.remove('open');

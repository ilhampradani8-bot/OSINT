                if (reg) showInAppSheet(reg, targetTitle);
              });
            });

          } else {
            govTbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#c00;">Gagal memuat registri RI.</td></tr>`;
          }
        }).catch(err => {
          govTbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#c00;">Gagal mengontak server API registri RI.</td></tr>`;
        });
      }

      modal.classList.add('open');
    }


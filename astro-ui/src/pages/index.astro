---
// MY-OSINT 95 (Astro Real-time Edition)
// Integrasi Maltego Graph Mapping, SpiderFoot Live Stream, Sherlock Real-time & Epieos
import '../styles/windows95.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MY-OSINT 95 (Real-Time Edition) - Maltego Graph & SpiderFoot Stream</title>
</head>
<body>

  <!-- Desktop Environment -->
  <div id="desktop">

    <!-- Main Workspace Window (Full Width Windows 95) -->
    <div id="workspace-window" style="width:100%; flex:1;">
      <!-- Title Bar -->
      <div class="window-titlebar">
        <div class="window-titlebar-title">
          <span id="window-icon">🕵️</span>
          <span id="window-title">MY-OSINT 95 (Pusat Penyelidikan Intelijen & Basis Data Daring RI)</span>
        </div>
        <div class="window-controls">
          <button class="win-btn" title="Minimize">_</button>
          <button class="win-btn" title="Maximize">□</button>
          <button class="win-btn" title="Tutup" style="color:#800000;">×</button>
        </div>
      </div>

      <!-- Menubar Retro with Page Switcher -->
      <div class="window-menubar" style="display:flex; align-items:center; gap:8px;">
        <span class="menu-item active" id="nav-btn-investigation" style="font-weight:bold; color:#00007c; background:#e0e0e0; border:1px inset #888;">
          🎯 <u>P</u>usat Penyelidikan OSINT
        </span>
        <span class="menu-item" id="nav-btn-logs" style="font-weight:bold;">
          🛡️ <u>L</u>og Keamanan, Error & SQL
        </span>
        <span class="menu-item" id="menu-ekspor"><u>E</u>kspor Dossier</span>
        <span class="menu-item" id="menu-sound"><u>S</u>uara: <b id="sound-status">AKTIF</b></span>
        <span style="margin-left:auto; font-size:11.5px; color:#000080; font-weight:bold; display:flex; align-items:center; gap:4px;">
          💽 <span class="status-indicator-green"></span>SQLite3 Local DB: AKTIF
        </span>
      </div>

      <!-- Content Area -->
      <div class="window-content-area">

        <!-- ============================================================
             PAGE 0: DOSSIER INTELIJEN REAL-TIME & PETA RELASI
             ============================================================ -->
        <div id="page-dashboard" class="page-view active">
          <!-- Target Search Bar -->
          <div class="group-box">
            <div class="group-box-title">Pusat Penambangan Intelijen & Dossier Spesifik (Multi-Parameter Target Recon)</div>
            <p style="margin-bottom:8px; font-size:12.5px; line-height:1.5; color:#333;">
              Masukkan parameter identitas target di bawah ini (<strong>bisa diisi 1 saja atau diisi beberapa/semuanya untuk mempersempit investigasi secara spesifik</strong>). Jika data 404/tidak ada, sistem akan jujur menampilkan "Tidak Ditemukan / 404", jika koneksi server/WAF error akan ditampilkan status riilnya, dan jika terdata akan dimunculkan NIM, Masked NIK, dan operator terkait.
            </p>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:8px; margin-bottom:8px; background:#f4f4f4; border:1px solid #aaa; padding:8px;">
              <div>
                <label for="realtime-name" style="font-size:11.5px; font-weight:bold; display:block; margin-bottom:2px;">👤 Nama Lengkap Target:</label>
                <input type="text" id="realtime-name" placeholder="Contoh: Ilham Pradani" style="width:100%; box-sizing:border-box;">
              </div>
              <div>
                <label for="realtime-location" style="font-size:11.5px; font-weight:bold; display:block; margin-bottom:2px;">📍 Lokasi / Kota / Provinsi:</label>
                <input type="text" id="realtime-location" placeholder="Contoh: Surabaya / Jawa Timur / Jakarta" style="width:100%; box-sizing:border-box;">
              </div>
              <div>
                <label for="realtime-address" style="font-size:11.5px; font-weight:bold; display:block; margin-bottom:2px;">🏠 Alamat / Kelurahan / Jalan:</label>
                <input type="text" id="realtime-address" placeholder="Contoh: Wonokromo / Gubeng" style="width:100%; box-sizing:border-box;">
              </div>
              <div>
                <label for="realtime-phone" style="font-size:11.5px; font-weight:bold; display:block; margin-bottom:2px;">📱 Nomor HP / WhatsApp:</label>
                <input type="text" id="realtime-phone" placeholder="Contoh: 081288889999" style="width:100%; box-sizing:border-box;">
              </div>
              <div>
                <label for="realtime-email" style="font-size:11.5px; font-weight:bold; display:block; margin-bottom:2px;">📧 Alamat Email / Akun:</label>
                <input type="text" id="realtime-email" placeholder="Contoh: ilham@gmail.com" style="width:100%; box-sizing:border-box;">
              </div>
            </div>

            <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
              <button class="btn btn-primary" id="btn-start-stream" style="font-weight:bold; padding:4px 14px !important;">
                ⚡ Mulai Penambangan Spesifik Multi-Entitas
              </button>
              <button class="btn" id="btn-sample-specific">
                🎯 Muat Contoh: Ilham Pradani (Surabaya + No HP)
              </button>
              <button class="btn" id="btn-clear-target-inputs">
                🧹 Kosongkan Form
              </button>
            </div>

            <div id="stream-status-bar" style="display:none; padding:6px 10px; background:#e0f2fe; border:1px solid #0284c7; font-size:12.5px; margin-top:8px;">
              <span><strong>Status:</strong> <span id="stream-status-text">Menghubungkan ke SSE stream...</span></span>
              <span style="margin-left:14px;"><strong>Data Dossier Ditemukan:</strong> <span id="stream-node-count">0</span></span>
              <span style="margin-left:14px;"><strong>Relasi Jaringan:</strong> <span id="stream-edge-count">0</span></span>
            </div>
          </div>

          <!-- View Mode Switcher -->
          <div class="view-mode-tabs" style="margin-top:6px;">
            <button class="view-tab-btn active" id="tab-btn-cards">
              <span>🗂️</span> Tampilan Kartu Multi-Profil (Data Diri & Identitas)
            </button>
            <button class="view-tab-btn" id="tab-btn-table">
              <span>📋</span> Tampilan Tabel Temuan Data (Sumber, Data Ditemukan, Status)
            </button>
            <span style="margin-left:auto; font-size:11.5px; color:#555; align-self:center;">
              💡 <em>Hanya data aktif (200 OK / terdata) yang ditampilkan. Seluruh 404 disaring otomatis.</em>
            </span>
          </div>

          <!-- VIEW 1: KARTU MULTI-PROFIL & IDENTITAS DITEMUKAN (PRIMARY) -->
          <div id="view-profile-cards" style="display:flex; flex-direction:column; gap:8px;">
            <div class="group-box" style="margin-top:0; padding:8px;">
              <div class="group-box-title" style="display:flex; justify-content:space-between; align-items:center;">
                <span>🗂️ Galeri Kartu Profil & Identitas Ditemukan (1 Nama Multi-Profil Berbeda)</span>
                <span id="profile-card-total-badge" class="badge-tag badge-info" style="font-size:11px;">0 Profil Daring</span>
              </div>
              <p style="margin:4px 0 8px 0; font-size:12px; color:#444;">
                ⚡ Menampilkan seluruh profil berbeda yang ditemukan secara daring (PDDikti Kemdiktisaintek, Akun Terverifikasi, Indeks Wilayah). Satu nama dapat memiliki banyak entitas berbeda di berbagai institusi.
              </p>
              <div id="master-profile-cards-grid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap:10px; max-height: calc(100vh - 330px); min-height: 480px; overflow-y:auto; padding:8px; background:#e0e0e0; border:2px inset #ffffff;">
                <div id="profile-cards-empty-state" style="grid-column: 1 / -1; text-align:center; padding:40px 10px; color:#666;">
                  Belum ada profil aktif. Ketik nama atau parameter target di atas, lalu tekan <strong>⚡ Mulai Penambangan Spesifik Multi-Entitas</strong>.
                </div>
              </div>
            </div>
          </div>

          <!-- VIEW 2: TABEL TEMUAN DATA DITEMUKAN (RINGKAS & BEBAS 404) -->
          <div id="view-dossier-table" style="display:none; flex-direction:column; gap:8px;">
            <div class="group-box" style="margin-top:0; padding:8px;">
              <div class="group-box-title">Tabel Temuan Data Daring (Sumber, Data Ditemukan, Status Respon)</div>
              <div class="excel-table-container" style="max-height: calc(100vh - 310px); min-height: 480px;">
                <table class="excel-table" id="master-dossier-table">
                  <thead>
                    <tr>
                      <th style="width:36px; text-align:center;">No</th>
                      <th style="width:160px;">Sumber</th>
                      <th>Data Ditemukan (ID / NIM / Judul / Akun / Nilai)</th>
                      <th style="width:140px; text-align:center;">Status Link</th>
                      <th style="width:170px; text-align:center;">Tautan & Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="master-dossier-tbody">
                    <tr>
                      <td colspan="5" style="text-align:center; padding:35px 10px; color:#666;">
                        Belum ada data dossier aktif. Ketik target di atas dan jalankan penambangan.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- ============================================================
             PAGE LOGS: SISTEM LOG KEAMANAN, ERROR WAF & DATABASE SQLITE
             ============================================================ -->
        <div id="page-logs" class="page-view">
          <div class="group-box" style="margin-bottom:12px;">
            <div class="group-box-title">🛡️ Sistem Pencatat Log Keamanan & Database SQL (SQLite)</div>
            <p style="margin-bottom:10px; font-size:13px; line-height:1.5;">
              Mencatat seluruh aktivitas penyelidikan secara otomatis ke basis data SQL lokal (<strong>backend/osint_archive.db</strong>). Setiap kegagalan koneksi, pemblokiran WAF Cloudflare (HTTP 403), error timeout, dan rekam jejak audit tersimpan permanen agar penelusuran identitas berikutnya tidak membebani server dan dapat dimuat langsung dari cache SQL.
            </p>

            <!-- Quick Metrics Header -->
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:10px; margin-bottom:12px;">
              <div style="background:#fff; border:2px inset #fff; padding:10px;">
                <div style="font-size:11px; color:#555; text-transform:uppercase;">Status Database SQL</div>
                <div style="font-size:16px; font-weight:bold; color:#000080; margin-top:4px;">SQLite Aktif</div>
                <div style="font-size:10px; color:#888;">osint_archive.db</div>
              </div>
              <div style="background:#fff; border:2px inset #fff; padding:10px;">
                <div style="font-size:11px; color:#555; text-transform:uppercase;">Total Log Tersimpan</div>
                <div style="font-size:16px; font-weight:bold; color:#333; margin-top:4px;" id="stat-log-count">0 Entri</div>
                <div style="font-size:10px; color:#888;">Real-time sync</div>
              </div>
              <div style="background:#fff; border:2px inset #fff; padding:10px;">
                <div style="font-size:11px; color:#555; text-transform:uppercase;">Blokir Cloudflare WAF</div>
                <div style="font-size:16px; font-weight:bold; color:#a00; margin-top:4px;" id="stat-waf-count">0 Terdeteksi</div>
                <div style="font-size:10px; color:#888;">HTTP 403 Forbidden</div>
              </div>
              <div style="background:#fff; border:2px inset #fff; padding:10px;">
                <div style="font-size:11px; color:#555; text-transform:uppercase;">Error & Gangguan Jaringan</div>
                <div style="font-size:16px; font-weight:bold; color:#c60; margin-top:4px;" id="stat-error-count">0 Event</div>
                <div style="font-size:10px; color:#888;">Timeout / DNS Fail</div>
              </div>
            </div>

            <!-- Action & Filter Bar -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; background:#e0e0e0; padding:6px; border:1px solid #999;">
              <div style="display:flex; align-items:center; gap:8px;">
                <label for="log-level-filter" style="font-size:12px; font-weight:bold;">Filter Level:</label>
                <select id="log-level-filter" style="font-size:12px; padding:2px 6px;">
                  <option value="ALL">Semua Level Log</option>
                  <option value="SECURITY_ALERT">🚨 SECURITY_ALERT (WAF / Blokir)</option>
                  <option value="ERROR">❌ ERROR (Koneksi / Timeout)</option>
                  <option value="WARN">⚠️ WARN (Peringatan)</option>
                  <option value="AUDIT">📋 AUDIT (Aktivitas Pencarian)</option>
                  <option value="INFO">ℹ️ INFO (Sistem)</option>
                </select>
              </div>

              <div style="display:flex; gap:6px;">
                <button class="btn btn-primary" id="btn-refresh-logs">🔄 Segarkan Log SQL</button>
                <button class="btn" id="btn-clear-sql-logs">🗑️ Kosongkan Log</button>
                <button class="btn" id="btn-export-logs">📥 Export JSON</button>
              </div>
            </div>
          </div>

          <!-- Log Table -->
          <div class="group-box">
            <div class="group-box-title">Tabel Rekam Jejak Keamanan & Error Sistem (SQLite)</div>
            <div class="excel-table-container" style="max-height: calc(100vh - 350px); min-height: 380px;">
              <table class="excel-table">
                <thead>
                  <tr>
                    <th style="width:135px;">Timestamp & ID</th>
                    <th style="width:130px;">Tingkat (Level)</th>
                    <th style="width:140px;">Komponen</th>
                    <th style="width:260px;">Peristiwa / Masalah</th>
                    <th>Detail Teknis & Payload</th>
                  </tr>
                </thead>
                <tbody id="security-logs-tbody">
                  <tr>
                    <td colspan="5" style="text-align:center; padding:30px; color:#666;">
                      Memuat rekaman log dari database SQL...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Dossier Intelijen Popup Modal (Windows 95) -->
  <div id="dossier-modal" class="retro-modal-overlay">
    <div class="retro-modal-window">
      <!-- Titlebar -->
      <div class="retro-modal-titlebar">
        <div class="retro-modal-title">
          <span>📁</span> <span id="modal-dossier-title">Dossier Intelijen: Target</span>
        </div>
        <div class="window-controls">
          <button class="win-btn" id="btn-close-modal" title="Tutup">×</button>
        </div>
      </div>

      <!-- Menubar Modal -->
      <div class="window-menubar">
        <span class="menu-item" id="modal-menu-print"><u>C</u>etak Dossier</span>
        <span class="menu-item" id="modal-menu-export"><u>E</u>xport JSON</span>
        <span class="menu-item" id="modal-menu-wayback-all"><u>A</u>rsip Semua (Wayback)</span>
      </div>

      <!-- Content Area -->
      <div class="retro-modal-content">
        <!-- Profile Identity Card -->
        <div class="dossier-card">
          <div class="dossier-header-row">
            <div class="dossier-avatar" id="modal-avatar">👤</div>
            <div style="flex:1;">
              <h3 id="modal-target-name" style="font-size:16px; color:#00007c; margin-bottom:4px;">Ilham Pradani</h3>
              <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <span class="badge-tag badge-info" id="modal-badge-type">Entitas Individu</span>
                <span class="badge-tag badge-success" id="modal-badge-status">Terverifikasi Real-Time</span>
              </div>
            </div>
          </div>

          <!-- Structured Demographics -->
          <dl class="dossier-meta-grid">
            <dt>Nama Lengkap / Alias:</dt>
            <dd id="modal-meta-name">-</dd>

            <dt>Nomor Telepon & Carrier:</dt>
            <dd id="modal-meta-phone">-</dd>

            <dt>Alamat / Wilayah / HLR:</dt>
            <dd id="modal-meta-address">-</dd>

            <dt>Indeks NIK Wilayah (Masked):</dt>
            <dd id="modal-meta-nik" style="font-weight:bold; color:#000080;">-</dd>

            <dt>Indeks NIM Terdaftar:</dt>
            <dd id="modal-meta-nim" style="font-weight:bold; color:#065f46;">-</dd>

            <dt>Email & Jejak Digital:</dt>
            <dd id="modal-meta-email">-</dd>

            <dt>Koneksi Registri RI:</dt>
            <dd id="modal-meta-registries">-</dd>

            <dt>Waktu Deteksi:</dt>
            <dd id="modal-meta-timestamp">-</dd>
          </dl>
        </div>

        <!-- Panduan & Cara Membuka Link 404 / Cache -->
        <div class="cache-info-box">
          <strong>💡 Solusi Investigasi: Cara Membuka Halaman yang 404 / Akun yang Sudah Terhapus:</strong><br>
          Jika akun media sosial atau tautan target mengembalikan error <strong>404 Not Found</strong> (karena dihapus pemilik, dinonaktifkan, atau diganti nama):
          <ul style="margin-left:20px; margin-top:4px;">
            <li>Klik tombol <strong>🏛️ Wayback Machine</strong>: Memuat salinan snapshot halaman web dari server Internet Archive saat halaman tersebut masih aktif di masa lalu.</li>
            <li>Klik tombol <strong>📦 Archive.today</strong>: Membuka mirror snapshot cadangan independen dari basis data arsip web global.</li>
            <li>Klik tombol <strong>🔍 Google Search Cache</strong>: Mencari riwayat cache perayap teks yang tersimpan di Google search.</li>
          </ul>
        </div>

        <!-- Discovered Accounts Table -->
        <div class="group-box" style="margin-top:0;">
          <div class="group-box-title">Daftar Akun Terdeteksi & Pemulihan Tautan Cache</div>
          <div class="excel-table-container" style="max-height:220px;">
            <table class="excel-table">
              <thead>
                <tr>
                  <th>Platform / Layanan</th>
                  <th>Kategori</th>
                  <th>Nilai / Akun</th>
                  <th>Tautan Langsung</th>
                  <th>Pemulihan Arsip (Jika 404 / Terhapus)</th>
                </tr>
              </thead>
              <tbody id="modal-accounts-tbody">
                <tr><td colspan="5" style="text-align:center;">Memuat data...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Section: Detail Basis Data & Registri Resmi Republik Indonesia -->
        <div class="group-box" style="margin-top:0;">
          <div class="group-box-title">Hasil Investigasi Registri Resmi RI: Temuan Langsung di Layar (Tanpa Direct Link Luar)</div>
          <p style="font-size:12px; margin-bottom:8px; color:#333;">
            Menampilkan 8 basis data resmi instansi pemerintah Republik Indonesia yang diintegrasikan, status verifikasi sistem, dan temuan intelijen langsung di dalam aplikasi:
          </p>
          <div class="excel-table-container" style="max-height:280px;">
            <table class="excel-table">
              <thead>
                <tr>
                  <th style="width:190px;">Instansi & Layanan RI</th>
                  <th style="width:140px;">Status Verifikasi</th>
                  <th>Hasil & Temuan Langsung di Layar</th>
                  <th style="width:230px;">Data Ekstraksi Terverifikasi</th>
                  <th style="width:160px; text-align:center;">Pratinjau Berkas In-App</th>
                </tr>
              </thead>
              <tbody id="modal-gov-tbody">
                <tr><td colspan="5" style="text-align:center; padding:15px;">Memuat data registri RI...</td></tr>
              </tbody>
            </table>
          </div>

          <!-- In-App Sheet Document Viewer -->
          <div id="inapp-sheet-container" style="display:none; margin-top:12px;">
            <div class="inapp-doc-sheet">
              <div class="inapp-doc-header">
                <div>
                  <h3 id="sheet-title" style="margin:0; font-size:14px; color:#000080;">BERKAS VERIFIKASI RESMI REPUBLIK INDONESIA</h3>
                  <div id="sheet-subtitle" style="font-size:11px; color:#555;">Pangkalan Data Pemerintah Terbuka</div>
                </div>
                <div id="sheet-stamp" class="inapp-doc-stamp">TERVERIFIKASI SAH</div>
              </div>
              <div id="sheet-body" style="line-height:1.6; margin-bottom:12px;"></div>
              <div style="border-top:1px dashed #aaa; padding-top:8px; display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:10px; color:#777;">MY-OSINT 95 Engine • Berkas Ditampilkan Langsung Tanpa Redirection</span>
                <button class="btn" id="btn-close-sheet" style="padding:2px 8px !important;">Tutup Pratinjau Berkas</button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Action Footer -->
      <div class="retro-modal-actions">
        <button class="btn btn-primary" id="btn-export-dossier-json">💾 Download Laporan (.json)</button>
        <button class="btn" id="btn-print-dossier">🖨️ Cetak Dokumen</button>
        <button class="btn" id="btn-close-modal-bottom">Tutup Jendela [ESC]</button>
      </div>
    </div>
  </div>

  <!-- Start Menu Popup -->
  <div id="start-menu">
    <div class="start-sidebar-strip">
      WINDOWS 95
    </div>
    <div class="start-menu-items">
      <div class="start-item" data-page="page-dashboard"><span>🎯</span> <strong>Pusat Penyelidikan OSINT</strong></div>
      <div class="start-item" data-page="page-logs"><span>🛡️</span> <strong>Log Keamanan & SQL</strong></div>
      <div class="start-item-divider"></div>
      <div class="start-item" id="start-menu-export"><span>💾</span> Simpan Laporan ke Disk</div>
      <div class="start-item" id="start-menu-about"><span>ℹ️</span> Tentang MY-OSINT 95</div>
    </div>
  </div>

  <!-- Taskbar Bawah -->
  <div id="taskbar">
    <div class="taskbar-left">
      <button class="btn start-button" id="start-btn">
        <span style="color:#000080; font-size:14px;">⊞</span> Mulai
      </button>
      <div class="taskbar-divider"></div>
      <div class="taskbar-window-tabs">
        <div class="task-tab active" id="taskbar-tab">
          <span id="taskbar-icon">🕸️</span>
          <span id="taskbar-title">Maltego Live Graph</span>
        </div>
      </div>
    </div>

    <div class="taskbar-right">
      <div class="system-tray">
        <span class="tray-icon" title="Audio Retro Aktif" id="tray-sound">🔊</span>
        <span class="tray-icon" title="Koneksi Aman">🛡️</span>
        <span id="clock" style="font-weight:600;">12:00:00</span>
      </div>
    </div>
  </div>

  <!-- Client-side Logic Script with Maltego Canvas Graph & SSE -->
  <script is:inline>
    // Audio Context & Retro Sound Synthesis
    let audioCtx = null;
    let soundEnabled = true;
    const history = [];

    function playSound(type) {
      if (!soundEnabled) return;
      try {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContext();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'click') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(800, now);
          osc.frequency.exponentialRampToValueAtTime(400, now + 0.05);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
          osc.start(now);
          osc.stop(now + 0.05);
        } else if (type === 'hit') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(587.33, now);
          osc.frequency.setValueAtTime(880.00, now + 0.08);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
        } else if (type === 'success') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(440, now);
          osc.frequency.setValueAtTime(554.37, now + 0.08);
          osc.frequency.setValueAtTime(659.25, now + 0.16);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
          osc.start(now);
          osc.stop(now + 0.35);
        } else if (type === 'error') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(150, now);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
        }
      } catch (e) {}
    }

    // ============================================================
    // MALTEGO RETRO CANVAS GRAPH ENGINE
    // ============================================================
    const graph = {
      nodes: [],
      edges: [],
      draggedNode: null,
      hoveredNode: null,
      canvas: null,
      ctx: null,

      init(canvasId) {
        this.canvas = document.getElementById(canvasId);
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.resize();
        window.addEventListener('resize', () => this.resize());

        this.canvas.addEventListener('mousedown', (e) => this.onMouseDown(e));
        this.canvas.addEventListener('mousemove', (e) => this.onMouseMove(e));
        window.addEventListener('mouseup', () => this.onMouseUp());
        this.render();
      },

      resize() {
        if (!this.canvas) return;
        const rect = this.canvas.parentElement.getBoundingClientRect();
        this.canvas.width = rect.width;
        this.canvas.height = rect.height;
        this.render();
      },

      clear() {
        this.nodes = [];
        this.edges = [];
        this.render();
      },

      addNode(node) {
        if (this.nodes.some(n => n.id === node.id)) return;
        if (!this.canvas) return;
        const cx = this.canvas.width / 2;
        const cy = this.canvas.height / 2;
        const count = this.nodes.length;
        
        let x = cx;
        let y = cy;
        if (count > 0) {
          const angle = (count * 0.75) % (Math.PI * 2);
          const radius = 130 + (count % 4) * 45;
          x = cx + Math.cos(angle) * radius;
          y = cy + Math.sin(angle) * radius;
        }

        this.nodes.push({
          id: node.id,
          label: node.label,
          type: node.type,
          icon: node.icon || '📌',
          color: node.color || '#00007c',
          url: node.url || null,
          details: node.details || '',
          x,
          y,
          radius: node.id === 'root' ? 30 : 22
        });
        this.render();
      },

      addEdge(edge) {
        if (this.edges.some(e => e.from === edge.from && e.to === edge.to)) return;
        this.edges.push(edge);
        this.render();
      },

      getNodeAt(x, y) {
        for (let i = this.nodes.length - 1; i >= 0; i--) {
          const n = this.nodes[i];
          const dist = Math.hypot(n.x - x, n.y - y);
          if (dist <= n.radius + 4) return n;
        }
        return null;
      },

      onMouseDown(e) {
        const rect = this.canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const node = this.getNodeAt(x, y);
        if (node) {
          this.draggedNode = node;
          this.startX = x;
          this.startY = y;
          this.canvas.style.cursor = 'grabbing';
          playSound('click');
        }
      },

      onMouseMove(e) {
        const rect = this.canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        if (this.draggedNode) {
          this.draggedNode.x = x;
          this.draggedNode.y = y;
          this.render();
          return;
        }

        const node = this.getNodeAt(x, y);
        const tooltip = document.getElementById('node-tooltip');
        if (node) {
          this.canvas.style.cursor = 'pointer';
          this.hoveredNode = node;
          if (tooltip) {
            tooltip.style.display = 'block';
            tooltip.style.left = `${x + 15}px`;
            tooltip.style.top = `${y + 15}px`;
            tooltip.innerHTML = `<strong>${node.icon} ${node.label}</strong><br><small style="color:#333;">${node.details || (node.url ? `<a href="${node.url}" target="_blank" style="color:#000080;">${node.url}</a>` : 'Entitas Terkoneksi')}</small><br><span style="color:#000080; font-size:10px;">[Klik node untuk buka Dossier Popup]</span>`;
          }
        } else {
          this.canvas.style.cursor = 'grab';
          this.hoveredNode = null;
          if (tooltip) tooltip.style.display = 'none';
        }
      },

      onMouseUp(e) {
        if (this.draggedNode && e) {
          const rect = this.canvas.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          if (Math.hypot(x - (this.startX || x), y - (this.startY || y)) < 6) {
            openDossierModal();
          }
        }
        this.draggedNode = null;
        if (this.canvas) this.canvas.style.cursor = 'grab';
      },

      render() {
        if (!this.ctx || !this.canvas) return;
        const ctx = this.ctx;
        ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        // Draw Retro Grid Background
        ctx.strokeStyle = '#f0f0f0';
        ctx.lineWidth = 1;
        for (let x = 0; x < this.canvas.width; x += 25) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, this.canvas.height);
          ctx.stroke();
        }
        for (let y = 0; y < this.canvas.height; y += 25) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(this.canvas.width, y);
          ctx.stroke();
        }

        // Draw Edges (Maltego Dotted Connection Lines)
        this.edges.forEach(edge => {
          const fromNode = this.nodes.find(n => n.id === edge.from);
          const toNode = this.nodes.find(n => n.id === edge.to);
          if (fromNode && toNode) {
            ctx.beginPath();
            ctx.setLineDash([4, 4]);
            ctx.strokeStyle = '#00007c';
            ctx.lineWidth = 1.5;
            ctx.moveTo(fromNode.x, fromNode.y);
            ctx.lineTo(toNode.x, toNode.y);
            ctx.stroke();
            ctx.setLineDash([]);

            // Edge label
            if (edge.label) {
              const midX = (fromNode.x + toNode.x) / 2;
              const midY = (fromNode.y + toNode.y) / 2;
              ctx.font = '9.5px Tahoma, sans-serif';
              ctx.fillStyle = '#666666';
              ctx.fillText(edge.label, midX + 4, midY - 4);
            }
          }
        });

        // Draw Nodes
        this.nodes.forEach(node => {
          ctx.beginPath();
          ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
          ctx.fillStyle = node.color;
          ctx.fill();

          // Retro 3D Bevel around node circle
          ctx.lineWidth = 2;
          ctx.strokeStyle = '#ffffff';
          ctx.stroke();

          // Icon
          ctx.font = node.id === 'root' ? '18px Arial' : '13px Arial';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillStyle = '#ffffff';
          ctx.fillText(node.icon, node.x, node.y);

          // Text Label Bawah Node
          ctx.font = '11.5px Tahoma, sans-serif';
          ctx.fillStyle = '#000000';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';

          // Box background for text
          const text = node.label.length > 20 ? node.label.slice(0, 18) + '...' : node.label;
          const textWidth = ctx.measureText(text).width;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.fillRect(node.x - textWidth / 2 - 4, node.y + node.radius + 3, textWidth + 8, 16);

          ctx.fillStyle = '#000000';
          ctx.fillText(text, node.x, node.y + node.radius + 4);
        });
      }
    };


          navLogs.style.color = '#000';
        } else if (pageId === 'page-logs') {
          navLogs.style.background = '#e0e0e0';
          navLogs.style.border = '1px inset #888';
          navLogs.style.color = '#00007c';
          navInvest.style.background = 'transparent';

      if (startBtn) startBtn.classList.remove('active');

      if (pageId === 'page-dashboard') {
        setTimeout(() => graph.resize(), 50);
      }
    }

    // ============================================================
    // LOG KEAMANAN & SQLITE LOG CONTROLLER
    // ============================================================
    let cachedLogsData = [];

    async function loadSecurityLogs(filterLevel = 'ALL') {
      const tbody = document.getElementById('security-logs-tbody');
      if (!tbody) return;

      try {
        const resp = await fetch(`/api/logs?level=${encodeURIComponent(filterLevel)}&limit=150`);
        const res = await resp.json();
        if (res && res.valid) {
          cachedLogsData = res.logs || [];

          // Update metric stats
          const statLogCount = document.getElementById('stat-log-count');
          const statWafCount = document.getElementById('stat-waf-count');
          const statErrorCount = document.getElementById('stat-error-count');
          if (statLogCount) statLogCount.innerText = `${res.total_stored || cachedLogsData.length} Entri`;

          let wafCount = 0;
          let errorCount = 0;
          cachedLogsData.forEach(l => {
            if (l.level === 'SECURITY_ALERT' || (l.message && l.message.includes('403'))) wafCount++;
            if (l.level === 'ERROR' || l.level === 'WARN') errorCount++;
          });
          if (statWafCount) statWafCount.innerText = `${wafCount} Terdeteksi`;
          if (statErrorCount) statErrorCount.innerText = `${errorCount} Event`;

          if (cachedLogsData.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="5" style="text-align:center; padding:35px 10px; color:#666;">
                  Belum ada log tercatat di basis data SQLite untuk filter ini.
                </td>
              </tr>
            `;
            return;
          }

          tbody.innerHTML = cachedLogsData.map(log => {
            let levelBadge = '';
            if (log.level === 'SECURITY_ALERT') {
              levelBadge = '<span class="badge-tag badge-danger" style="background:#b91c1c; color:#fff; font-weight:bold;">🚨 SECURITY_ALERT</span>';
            } else if (log.level === 'ERROR') {
              levelBadge = '<span class="badge-tag badge-danger">❌ ERROR</span>';
            } else if (log.level === 'WARN') {
              levelBadge = '<span class="badge-tag badge-warning">⚠️ WARN</span>';
            } else if (log.level === 'AUDIT') {
              levelBadge = '<span class="badge-tag badge-info">📋 AUDIT</span>';
            } else {
              levelBadge = `<span class="badge-tag badge-secondary">ℹ️ ${log.level}</span>`;
            }

            let detailStr = '';
            if (typeof log.details === 'object' && log.details !== null) {
              detailStr = `<code style="font-size:11px; color:#333; word-break:break-all;">${JSON.stringify(log.details)}</code>`;
            } else if (log.details) {
              detailStr = `<span style="font-size:11.5px; color:#444;">${log.details}</span>`;
            } else {
              detailStr = '<span style="color:#888;">-</span>';
            }

            return `
              <tr>
                <td style="font-size:11px; font-family:monospace; color:#333;">
                  #${log.id || '-'} <br><small style="color:#777;">${(log.timestamp || '').slice(0, 19).replace('T', ' ')}</small>
                </td>
                <td>${levelBadge}</td>
                <td><strong style="color:#000080; font-size:11.5px;">${log.component || 'SYS'}</strong></td>
                <td style="font-size:12px; font-weight:500; color:#111; line-height:1.4;">${log.message || '-'}</td>
                <td style="background:#fafafa; border-left:1px solid #ddd;">${detailStr}</td>
              </tr>
            `;
          }).join('');
        }
      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="5" style="color:red; padding:20px; text-align:center;">Gagal memuat log dari server SQLite: ${err.message}</td></tr>`;
      }
    }

    async function clearSecurityLogs() {
      if (!confirm('Apakah Anda yakin ingin mengosongkan seluruh riwayat log keamanan di database SQLite?')) return;
      playSound('click');
      try {
        const resp = await fetch('/api/logs/clear', { method: 'POST' });
        const res = await resp.json();
        if (res && res.valid) {
          playSound('success');
          alert('Basis data log keamanan berhasil dikosongkan.');
          loadSecurityLogs();
        }
      } catch (e) {
        alert('Gagal membersihkan log: ' + e.message);
      }
    }

    function exportSecurityLogs() {
      if (!cachedLogsData || cachedLogsData.length === 0) {
        return alert('Tidak ada data log untuk diekspor!');
      }
      playSound('success');
      const blob = new Blob([JSON.stringify(cachedLogsData, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `OSINT_SECURITY_LOGS_${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
    }

    setInterval(() => {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      const clockEl = document.getElementById('clock');
      if (clockEl) clockEl.innerText = `${h}:${m}:${s}`;
    }, 1000);


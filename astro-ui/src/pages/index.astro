              const isNotFound = r.status_badge.includes('404') || r.status_badge.includes('TIDAK') || r.status_badge.includes('NIR');
              const statusPill = `<span class="badge-tag" style="background:${isNotFound ? '#f3f4f6' : '#e0f2fe'}; color:${isNotFound ? '#6b7280' : (r.status_color || '#0369a1')}; border:1px solid #ccc; font-weight:bold; font-size:11px; display:inline-block;">${r.status_icon || '🛡️'} ${r.status_badge || 'TERDATA'}</span>`;
              
              const fieldBadges = (r.ekstraksi_data && r.ekstraksi_data.length > 0)
                ? r.ekstraksi_data.map(d => `<div style="font-size:11px; margin-bottom:2px;"><b>${d.label}:</b> <span style="color:#000080;">${d.nilai}</span></div>`).join('')
                : '<span style="color:#888; font-size:11px;">-</span>';

              const findingsDisplay = (!isNotFound && r.temuan_ringkas && r.temuan_ringkas !== '-')
                ? `<strong>${r.temuan_ringkas}</strong>`
                : '<span style="color:#888; font-size:11px;">-</span>';

              return `
                <tr>
                  <td>
                    <b>${r.nama_layanan}</b><br>
                    <span style="font-size:11px; color:#555;">${r.instansi}</span>
                  </td>
                  <td>${statusPill}</td>
                  <td style="font-size:11.5px; line-height:1.45; color:#111;">
                    ${findingsDisplay}
                  </td>
                  <td style="font-size:11px; background:#fafafa; border-left:1px solid #eee;">
                    ${fieldBadges}
                  </td>
                  <td style="text-align:center; white-space:nowrap;">
                    ${!isNotFound && r.ekstraksi_data && r.ekstraksi_data.length > 0 ? `
                      <button class="btn btn-primary btn-preview-sheet" data-regidx="${rIdx}" style="padding:3px 9px !important; font-size:11.5px; font-weight:bold;">
                        📄 Buka Lembar Berkas
                      </button>
                    ` : '<span style="color:#888; font-size:11px;">Nihil Berkas</span>'}
                  </td>
                </tr>
              `;
            }).join('');

            // Attach listeners to preview sheet buttons
            govTbody.querySelectorAll('.btn-preview-sheet').forEach(b => {

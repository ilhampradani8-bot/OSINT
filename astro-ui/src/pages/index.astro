    function renderMasterDossierTable() {
      const tbody = document.getElementById('master-dossier-tbody');
      if (!tbody) return;

      // Filter: Kalo 404 / nihil gausah tampil nambah2 baris!
      const positiveRecords = (masterDossier.records || []).filter(rec => {
        if (rec.found === false) return false;
        const b = (rec.status_badge || '').toUpperCase();
        if (b.includes('404') || b.includes('TIDAK') || b.includes('NIR') || b.includes('OFFLINE')) {
          return false;
        }
        if (!rec.label && !rec.temuan_ringkas && (!rec.ekstraksi_data || rec.ekstraksi_data.length === 0)) {
          return false;
        }
        return true;
      });

      if (positiveRecords.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:35px 10px; color:#666;">Belum ada temuan data aktif (HTTP 200 OK). Seluruh status 404 disaring otomatis agar tampilan bersih.</td></tr>`;
        return;
      }

      tbody.innerHTML = positiveRecords.map((rec, idx) => {
        const hasUrl = Boolean(rec.url);

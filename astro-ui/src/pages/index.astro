    // ============================================================
    // REAL-TIME SSE STREAMING CONTROLLER
    // ============================================================
    let activeEventSource = null;

    function startRealtimeRecon(params) {
      let name = '';
      let location = '';
      let address = '';
      let phone = '';
      let email = '';

      if (typeof params === 'string') {
        name = params.trim();
      } else if (typeof params === 'object' && params !== null) {
        name = (params.name || '').trim();
        location = (params.location || '').trim();
        address = (params.address || '').trim();
        phone = (params.phone || '').trim();
        email = (params.email || '').trim();
      }

      const mainQuery = name || phone || email || location || address;
      if (!mainQuery) return alert('Masukkan setidaknya salah satu parameter: Nama, Lokasi, Alamat, No HP, atau Email!');

      playSound('click');

      if (activeEventSource) {
        activeEventSource.close();
      }

      // Reset master profile cards grid
      window._profileCardsList = [];
      const cardsGrid = document.getElementById('master-profile-cards-grid');
      if (cardsGrid) {
        cardsGrid.innerHTML = '<div id="profile-cards-empty-state" style="grid-column: 1 / -1; text-align:center; padding:40px 10px; color:#666;">Sedang mencari data daring...</div>';
      }
      const cardsBadge = document.getElementById('profile-card-total-badge');
      if (cardsBadge) cardsBadge.innerText = '0 Profil Daring';

      const fullAddress = location ? `${location}${address ? ' (' + address + ')' : ''}` : (address || 'Indonesia / Asia');

      masterDossier = {
        query: mainQuery,
        name: name || (phone ? `Target HP: ${phone}` : (email ? `Target Email: ${email}` : mainQuery)),
        phone: phone || (mainQuery.startsWith('08') || mainQuery.startsWith('+62') ? mainQuery : '-'),
        carrier: '-',
        address: fullAddress,
        email: email || (mainQuery.includes('@') ? mainQuery : '-'),
        registries: '-',
        records: []
      };

      graph.clear();
      document.getElementById('stream-status-bar').style.display = 'block';
      document.getElementById('stream-status-text').innerText = 'Menambang data secara real-time via SSE & SQL Archive...';

      // Cek Arsip SQLite Database terlebih dahulu
      fetch(`/api/cached?query=${encodeURIComponent(mainQuery)}`)
        .then(r => r.json())
        .then(cacheRes => {
          if (cacheRes && cacheRes.found && cacheRes.record) {
            const cached = cacheRes.record;
            const statusEl = document.getElementById('stream-status-text');
            if (statusEl) {
              statusEl.innerText = `💽 Cache SQL Ditemukan (${cached.updated_at || 'Arsip'}). Memuat data cepat...`;
            }
            if (Array.isArray(cached.candidates) && cached.candidates.length > 0) {
              cached.candidates.forEach(cand => {
                addProfileCard({
                  name: cand.nama,
                  id_number: cand.nim,
                  org_location: `${cand.nama_pt} ${cand.sinkatan_pt ? '(' + cand.sinkatan_pt + ')' : ''}`,
                  role_or_prodi: cand.nama_prodi,
                  source: 'SQLite DB (PDDikti Arsip)',
                  status: 'HTTP 200 OK',
                  icon: '🎓',
                  url: `https://pddikti.kemdiktisaintek.go.id/data_mahasiswa?keyword=${encodeURIComponent(cand.nim)}`
                });
              });
            }
            if (Array.isArray(cached.positive_findings) && cached.positive_findings.length > 0) {
              cached.positive_findings.forEach(f => {
                addPositiveDossierRow(f);
              });
            }
          }
        })
        .catch(() => {});
      const strTbody = document.getElementById('stream-entities-tbody'); if (strTbody) strTbody.innerHTML = '';
      const termInit = document.getElementById('spiderfoot-terminal'); if (termInit) termInit.innerHTML = `<span style="color:#888;">[${new Date().toLocaleTimeString()}]</span> <span style="color:#00ffff;">=== INISIASI PENAMBANGAN REAL-TIME UNTUK '${mainQuery}' ===</span><br>`;
      renderMasterDossierTable();

      let nodeCount = 0;
      let edgeCount = 0;

      const urlParams = new URLSearchParams();
      if (name) urlParams.append('query', name);
      else if (mainQuery) urlParams.append('query', mainQuery);
      if (location) urlParams.append('location', location);
      if (address) urlParams.append('address', address);
      if (phone) urlParams.append('phone', phone);
      if (email) urlParams.append('email', email);

      activeEventSource = new EventSource(`/api/stream?${urlParams.toString()}`);

      activeEventSource.addEventListener('log', (e) => {
        try {
          const data = JSON.parse(e.data);
          appendSpiderfootLog(data);
        } catch (err) {}
      });

      activeEventSource.addEventListener('candidate_profile', (e) => {
        try {
          const cand = JSON.parse(e.data);
          addProfileCard({
            name: cand.nama,
            id_number: cand.nim,
            org_location: `${cand.nama_pt} ${cand.sinkatan_pt ? '(' + cand.sinkatan_pt + ')' : ''}`,
            role_or_prodi: cand.nama_prodi,
            source: 'PDDikti Kemdiktisaintek (Live)',
            status: 'HTTP 200 OK',
            icon: '🎓',
            url: `https://pddikti.kemdiktisaintek.go.id/data_mahasiswa?keyword=${encodeURIComponent(cand.nim)}`
          });
        } catch (err) {}
      });

      activeEventSource.addEventListener('stream_item', (e) => {
        try {
          const item = JSON.parse(e.data);
          if (item && item.found) {
            addProfileCard({
              name: masterDossier.name,
              id_number: item.platform,
              org_location: item.region || 'Global / Indonesia',
              role_or_prodi: `Kategori: ${item.category} | Akun Terverifikasi`,
              source: `Sherlock-${item.platform}`,
              status: 'HTTP 200 OK',
              icon: '👤',
              url: item.profile_url
            });
          }
        } catch (err) {}
      });

      activeEventSource.addEventListener('graph_node', (e) => {
        try {
          const node = JSON.parse(e.data);
          graph.addNode(node);
          nodeCount++;
          document.getElementById('stream-node-count').innerText = nodeCount;
          playSound('hit');

          // Update dossier demographics if found
          if (node.type === 'phone') {
            masterDossier.phone = node.label;
            masterDossier.carrier = node.details || 'Carrier Asia';
          } else if (node.type === 'geo') {
            masterDossier.address = node.label;
          } else if (node.type === 'email') {
            masterDossier.email = node.label;
          } else if (node.type === 'gov') {
            masterDossier.registries = 'Terdaftar di Basis Data RI';
          } else if (node.type === 'nik') {
            const elNik = document.getElementById('modal-meta-nik');
            if (elNik) elNik.innerText = node.label.replace('NIK: ', '').trim();
          }

          masterDossier.records.push({
            id: node.id,
            name: masterDossier.name,
            phone: masterDossier.phone,
            address: masterDossier.address,
            label: node.label,
            type: node.type,
            icon: node.icon || '📌',
            source: node.type === 'social' ? 'Sherlock' : (node.type === 'phone' ? 'Telco/HLR' : (node.type === 'gov' ? 'Gov Registry' : (node.type === 'email' ? 'Epieos' : 'SpiderFoot'))),
            status_badge: node.status_badge || '',
            temuan_ringkas: node.temuan_ringkas || '',
            ekstraksi_data: node.ekstraksi_data || [],
            details: node.details || '',
            url: node.url || null
          });
          renderMasterDossierTable();

          // Also append to feed summary table
          const tbody = document.getElementById('stream-entities-tbody');
          if (tbody) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><span class="badge-tag badge-info">${node.icon} ${node.type}</span></td>
              <td><strong>${node.label}</strong><br><small style="color:#555;">${node.details || ''}</small></td>
              <td>${node.url ? `<a href="${node.url}" target="_blank" class="btn" style="padding:1px 6px !important;">🌐 Buka</a>` : '-'}</td>
            `;
            tbody.appendChild(tr);
          }
        } catch (err) {}
      });

      activeEventSource.addEventListener('graph_edge', (e) => {
        try {
          const edge = JSON.parse(e.data);
          graph.addEdge(edge);
          edgeCount++;
          document.getElementById('stream-edge-count').innerText = edgeCount;
        } catch (err) {}
      });

      activeEventSource.addEventListener('stream_item', (e) => {
        try {
          const item = JSON.parse(e.data);
          if (item.found) {
            playSound('hit');
            masterDossier.records.push({
              id: `soc_${item.platform}_${Date.now()}`,
              name: masterDossier.name,
              phone: masterDossier.phone,
              address: masterDossier.address,
              label: `${item.platform} Profile`,
              type: item.category || 'Media Sosial',
              icon: '👤',
              source: `Sherlock / ${item.platform}`,
              details: `Akun Terdaftar: ${item.profile_url}`,
              url: item.profile_url
            });
            renderMasterDossierTable();
          }
        } catch (err) {}
      });

      activeEventSource.addEventListener('done', (e) => {
        playSound('success');
        document.getElementById('stream-status-text').innerText = 'Penyelidikan Real-Time Selesai!';
        appendSpiderfootLog({ level: 'SUCCESS', source: 'SYS', message: 'Seluruh thread investigasi selesai mengekstrak data.' });
        if (activeEventSource) {
          activeEventSource.close();
          activeEventSource = null;
        }
      });

      activeEventSource.addEventListener('error', (e) => {
        if (activeEventSource) {
          activeEventSource.close();
          activeEventSource = null;
        }
        document.getElementById('stream-status-text').innerText = 'Stream selesai atau koneksi tertutup.';
      });
    }

    // Navigasi & Setup Halaman Tunggal (OSINT & Security Log SQLite)
    const pageMeta = {
      'page-dashboard': { title: 'Pusat Penyelidikan Intelijen & Dossier (Maltego OSINT)', icon: '🎯' },
      'page-logs': { title: 'Log Keamanan, Error WAF & Basis Data SQL (SQLite)', icon: '🛡️' }
    };

